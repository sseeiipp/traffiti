# 배포 환경(NODE_ENV=production)에서는 DATABASE_URL, JWT_SECRET이 없으면 서버가 뜨지 않는다.
NODE_ENV=production
PORT=3000
# 예: Supabase → Project Settings → Database → Connection string (Session pooler)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres
DATABASE_SSL=true
# openssl rand -base64 48 로 만든 긴 무작위 문자열
JWT_SECRET=
# 웹 관리 화면 등 브라우저에서 부를 주소만 쉼표로(앱만 쓰면 비워 둔다)
CORS_ORIGINS=
# 키를 넣지 않은 소셜 제공자는 데모 로그인(기기 식별자)으로 돈다. true면 실제 로그인이 실패해도 데모로 넘어간다
SOCIAL_LOGIN_DEMO=false
# 소셜 제공자가 돌려보낼 이 서버 주소. Railway는 RAILWAY_PUBLIC_DOMAIN으로 알아서 채워서 비워 둬도 된다
PUBLIC_URL=
# 각 콘솔의 Redirect URI는 {PUBLIC_URL}/auth/oauth/{kakao|naver|google}/callback
# 카카오 developers → 앱 키의 REST API 키(Client Secret을 켰으면 그 값도)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 네이버 developers → 애플리케이션 → Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Google Cloud → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
