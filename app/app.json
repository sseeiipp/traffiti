{
  "expo": {
    "name": "Traffiti",
    "slug": "travity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "러닝을 기록하는 동안 달린 경로를 그리기 위해 위치를 사용해요.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationAlwaysAndWhenInUseUsageDescription": "화면이 꺼져도 러닝 경로가 끊기지 않게, 러닝을 기록하는 동안에만 위치를 사용해요.",
        "UIBackgroundModes": [
          "location"
        ]
      },
      "bundleIdentifier": "com.travity.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#A8E923",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "package": "com.travity.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Traffiti",
      "shortName": "Traffiti",
      "themeColor": "#A3E635",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "러닝을 기록하는 동안 달린 경로를 그리기 위해 위치를 사용해요.",
          "locationAlwaysAndWhenInUsePermission": "화면이 꺼져도 러닝 경로가 끊기지 않게, 러닝을 기록하는 동안에만 위치를 사용해요.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#A8E923"
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필과 크루 사진을 고르기 위해 사진첩을 사용해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "작품 이미지를 사진첩에 저장하기 위해 사용해요.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "scheme": "travity",
    "extra": {
      "eas": {
        "projectId": "6c2d297d-5c33-460c-a2f1-a7539cef2ace"
      }
    }
  }
}
